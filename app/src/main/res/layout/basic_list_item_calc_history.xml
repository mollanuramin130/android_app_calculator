<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="4dp"
    android:paddingEnd="4dp">

    <HorizontalScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:scrollbars="horizontal"
        android:fillViewport="false"
        android:paddingStart="0dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:minWidth="120dp">

            <TextView
                android:id="@+id/history_expression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mode_button_text_light"
                android:textSize="16sp"
                android:singleLine="true"
                android:ellipsize="none"
                android:gravity="end" />

            <TextView
                android:id="@+id/history_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/mode_button_text_light"
                android:textSize="18sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="none"
                android:gravity="end" />

            <TextView
                android:id="@+id/history_timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/history_timestamp_text"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:gravity="end" />
        </LinearLayout>
    </HorizontalScrollView>

    <Button
        android:id="@+id/history_btn_use"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="52dp"
        android:text="@string/history_use"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/button_history_use"
        android:textColor="@color/mode_button_text_light"
        android:elevation="2dp"
        style="?android:attr/borderlessButtonStyle" />
</LinearLayout>
