<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:minWidth="120dp"
        android:layout_marginEnd="48dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/ai_card_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/ai_result_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ai_bot_title"
                tools:text="EMI Calculator" />

            <TextView
                android:id="@+id/ai_result_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/ai_bot_primary"
                android:lineSpacingMultiplier="1.2"
                tools:text="₹10,234/month" />

            <TextView
                android:id="@+id/ai_result_explanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="@color/ai_bot_secondary"
                android:lineSpacingMultiplier="1.25"
                android:breakStrategy="balanced"
                android:hyphenationFrequency="none"
                tools:text="Based on 5L loan at 8% for 5 years" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
