<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mode_screen_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Result Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/discount_result_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/discount_card_primary"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/discount_label_discounted_price"
                        android:textColor="@color/discount_text_secondary"
                        android:textSize="16sp"
                        android:letterSpacing="0.03" />

                    <TextView
                        android:id="@+id/discount_main_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="75.00"
                        android:textColor="@color/discount_positive"
                        android:textSize="44sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/discount_you_save"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/discount_you_save"
                        android:textColor="@color/discount_accent"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/discount_text_secondary"
                        android:alpha="0.3" />

                    <!-- Mini row: Original | Discount | Price Off -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/discount_label_original"
                                android:textColor="@color/discount_text_secondary"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/discount_summary_original"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="100.00"
                                android:textColor="@color/discount_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/discount_label_discount"
                                android:textColor="@color/discount_text_secondary"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/discount_summary_pct"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="-25%"
                                android:textColor="@color/discount_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/discount_label_price_off"
                                android:textColor="@color/discount_text_secondary"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/discount_summary_off"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="-25.00"
                                android:textColor="@color/discount_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Original Price Input Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/discount_input_card"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/discount_original_price"
                    android:textColor="@color/discount_text_secondary"
                    android:textSize="14sp" />
                <EditText
                    android:id="@+id/discount_original"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="80dp"
                    android:inputType="numberDecimal"
                    android:hint="0"
                    android:text="100"
                    android:textColor="@color/discount_text_primary"
                    android:textColorHint="@color/discount_text_secondary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:background="@null"
                    android:layout_marginEnd="8dp" />
                <ImageButton
                    android:id="@+id/discount_original_minus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/discount_btn_plus"
                    android:src="@drawable/ic_bmi_minus"
                    android:contentDescription="Decrease"
                    app:tint="@color/discount_text_primary"
                    android:layout_marginEnd="4dp" />
                <ImageButton
                    android:id="@+id/discount_original_plus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/discount_btn_plus"
                    android:src="@android:drawable/ic_input_add"
                    android:contentDescription="Increase"
                    app:tint="@color/discount_text_primary" />
            </LinearLayout>

            <!-- 3. Discount Percentage Input Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/discount_input_card"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textColor="@color/discount_text_secondary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/discount_percentage"
                    android:textColor="@color/discount_text_secondary"
                    android:textSize="14sp" />
                <EditText
                    android:id="@+id/discount_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="60dp"
                    android:inputType="numberDecimal"
                    android:hint="0"
                    android:text="25"
                    android:textColor="@color/discount_text_primary"
                    android:textColorHint="@color/discount_text_secondary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:background="@null"
                    android:layout_marginEnd="4dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textColor="@color/discount_text_secondary"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp" />
                <ImageButton
                    android:id="@+id/discount_percent_minus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/discount_btn_plus"
                    android:src="@drawable/ic_bmi_minus"
                    android:contentDescription="Decrease"
                    app:tint="@color/discount_text_primary"
                    android:layout_marginEnd="4dp" />
                <ImageButton
                    android:id="@+id/discount_percent_plus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/discount_btn_plus"
                    android:src="@android:drawable/ic_input_add"
                    android:contentDescription="Increase"
                    app:tint="@color/discount_text_primary" />
            </LinearLayout>

            <!-- 4. Discount Amount Input Card (optional) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/discount_input_card"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/discount_amount"
                    android:textColor="@color/discount_text_secondary"
                    android:textSize="14sp" />
                <EditText
                    android:id="@+id/discount_amount_input"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="80dp"
                    android:inputType="numberDecimal"
                    android:hint="0"
                    android:text=""
                    android:textColor="@color/discount_text_primary"
                    android:textColorHint="@color/discount_text_secondary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:background="@null"
                    android:layout_marginEnd="8dp" />
                <ImageButton
                    android:id="@+id/discount_amount_minus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/discount_btn_plus"
                    android:src="@drawable/ic_bmi_minus"
                    android:contentDescription="Decrease"
                    app:tint="@color/discount_text_primary"
                    android:layout_marginEnd="4dp" />
                <ImageButton
                    android:id="@+id/discount_amount_plus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/discount_btn_plus"
                    android:src="@android:drawable/ic_input_add"
                    android:contentDescription="Increase"
                    app:tint="@color/discount_text_primary" />
            </LinearLayout>

            <!-- 5. Calculate Button -->
            <Button
                android:id="@+id/discount_calculate_btn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/discount_btn_calculate"
                android:text="@string/discount_calculate_btn"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:elevation="8dp" />

            <!-- 6. Detailed Breakdown Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/discount_breakdown_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/discount_card_primary"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/discount_breakdown_line1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/discount_breakdown_original"
                        android:textColor="@color/discount_text_primary"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp" />
                    <TextView
                        android:id="@+id/discount_breakdown_line2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/discount_breakdown_discount"
                        android:textColor="@color/discount_text_primary"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp" />
                    <TextView
                        android:id="@+id/discount_breakdown_line3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/discount_breakdown_price_off"
                        android:textColor="@color/discount_text_primary"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp" />
                    <TextView
                        android:id="@+id/discount_breakdown_final"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/discount_breakdown_final"
                        android:textColor="@color/discount_positive"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
