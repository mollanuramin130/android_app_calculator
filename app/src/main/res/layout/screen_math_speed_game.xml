<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/math_speed_screen_bg">

    <!-- Score / Timer / Lives card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/math_speed_status_card"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/math_speed_card_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/math_speed_score_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/math_game_score"
                android:textColor="@color/math_speed_score_color"
                android:textSize="16sp"
                android:textStyle="normal"
                tools:text="Score: 0" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/math_speed_timer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/math_game_time"
                android:textColor="@color/math_speed_timer_color"
                android:textSize="16sp"
                tools:text="Time: 60 sec" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/math_speed_lives_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/math_speed_live_1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:gravity="center"
                    android:text="♥"
                    android:textColor="@color/math_speed_wrong"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/math_speed_live_2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:text="♥"
                    android:textColor="@color/math_speed_wrong"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/math_speed_live_3"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:text="♥"
                    android:textColor="@color/math_speed_wrong"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Falling answers area: do not consume touches so falling buttons receive clicks -->
    <FrameLayout
        android:id="@+id/math_speed_play_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/math_speed_status_card"
        app:layout_constraintBottom_toTopOf="@id/math_speed_equation_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Equation card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/math_speed_equation_card"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/math_speed_card_bg"
        app:layout_constraintTop_toBottomOf="@id/math_speed_play_area"
        app:layout_constraintBottom_toTopOf="@id/math_speed_control_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/math_speed_equation_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="@color/math_speed_equation_text"
            android:textSize="32sp"
            android:textStyle="bold"
            tools:text="8 × 4 = ?" />
    </com.google.android.material.card.MaterialCardView>

    <!-- START GAME / RESET -->
    <LinearLayout
        android:id="@+id/math_speed_control_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/math_speed_start_btn"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/math_game_start"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:cornerRadius="24dp"
            app:backgroundTint="#4CAF50" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/math_speed_reset_btn"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/math_game_reset"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:cornerRadius="24dp"
            app:backgroundTint="#E53935" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
