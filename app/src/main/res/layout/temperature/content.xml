<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mode_screen_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/temp_screen_bg"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_temp_card"
                android:padding="24dp"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_temp_thermometer"
                        android:contentDescription="@null"
                        android:layout_marginEnd="10dp"
                        android:tint="@color/temp_thermometer_tint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/temp_enter_heading"
                        android:textColor="@color/temp_label_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/temp_input"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:inputType="numberDecimal|numberSigned"
                    android:hint="@string/temp_enter_hint"
                    android:textColorHint="@color/temp_label_text"
                    android:textColor="@color/age_input_text"
                    android:background="@drawable/bg_temp_input_bordered"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="16sp"
                    android:layout_marginBottom="18dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="18dp">
                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:text="@string/temp_from_label"
                        android:textColor="@color/temp_label_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="12dp" />
                    <Spinner
                        android:id="@+id/temp_from"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_temp_spinner"
                        android:minHeight="50dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="40dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="22dp">
                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:text="@string/temp_to_label"
                        android:textColor="@color/temp_label_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="12dp" />
                    <Spinner
                        android:id="@+id/temp_to"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_temp_spinner"
                        android:minHeight="50dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="40dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/temp_calculate"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="22dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/button_temp_convert_coral"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:elevation="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_temp_convert_refresh"
                        android:contentDescription="@null"
                        android:layout_marginEnd="12dp"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/temp_convert"
                        android:textColor="@android:color/white"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textAllCaps="true" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/temp_result_heading"
                    android:textColor="@color/temp_label_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"
                    android:gravity="start" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_temp_input_bordered"
                    android:padding="18dp">
                    <TextView
                        android:id="@+id/temp_result"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/temp_label_text"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"
                        android:text="—" />
                    <TextView
                        android:id="@+id/temp_formula"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/temp_label_text"
                        android:textSize="13sp"
                        android:alpha="0.8"
                        android:text="" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/temp_quick_swap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_temp_quick_swap"
                    android:contentDescription="@string/temp_quick_swap"
                    android:layout_marginEnd="10dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/temp_quick_swap"
                    android:textColor="@color/temp_quick_swap_text"
                    android:textSize="15sp"
                    android:textAllCaps="true"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
