<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/update_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/update_bottom_sheet_title"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textStyle="bold"
        tools:text="New version available 🚀" />

    <TextView
        android:id="@+id/update_sheet_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/update_bottom_sheet_message"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?android:attr/textColorSecondary"
        tools:text="A new version is ready. Update in the background without leaving the app." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_sheet_btn_later"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/update_btn_later" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_sheet_btn_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_btn_now" />
    </LinearLayout>
</LinearLayout>
