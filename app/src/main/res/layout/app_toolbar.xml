<?xml version="1.0" encoding="utf-8"?>
<!-- Single app topbar: Basic Calculator, Temperature, EMI, Interest, Currency, Date, BMI, Discount.
     Style from colors: mode_toolbar_bg, mode_toolbar_icon. Dimens: app_toolbar_*. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_toolbar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/app_toolbar_height"
    android:minHeight="@dimen/app_toolbar_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/mode_toolbar_bg"
    android:paddingStart="@dimen/app_toolbar_padding_horizontal"
    android:paddingEnd="@dimen/app_toolbar_padding_horizontal"
    android:elevation="@dimen/app_toolbar_elevation">

    <ImageButton
        android:id="@+id/btn_drawer"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_menu"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/drawer_title"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:layout_gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        app:tint="@color/mode_toolbar_icon" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:id="@+id/mode_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@color/mode_toolbar_icon"
            android:textSize="@dimen/app_toolbar_title_text_size"
            android:textStyle="bold"
            android:visibility="visible"
            android:ellipsize="end"
            android:maxLines="1" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btn_menu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_more_vert"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/menu_help"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:layout_gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        app:tint="@color/mode_toolbar_icon" />
</LinearLayout>
