<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mode_screen_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/mode_screen_bg"
        android:padding="@dimen/mode_content_scroll_padding_wide">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card 1: Enter Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/emi_card_bg"
                android:padding="24dp"
                android:elevation="4dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">
                    <ImageView
                        android:layout_width="@dimen/mode_content_icon_section"
                        android:layout_height="@dimen/mode_content_icon_section"
                        android:src="@drawable/ic_nav_emi"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="@dimen/mode_content_icon_margin_end_section"
                        android:scaleType="fitCenter" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emi_enter_details"
                        android:textColor="@color/emi_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Loan Amount -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/emi_loan_amount"
                    android:textColor="@color/emi_text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/emi_input_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginBottom="8dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@string/cd_currency_indicator"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_generic_currency"
                        app:tint="@color/emi_slider_active" />
                    <EditText
                        android:id="@+id/emi_principal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:hint="@string/hint_enter_amount"
                        android:textColor="@color/emi_input_text"
                        android:textColorHint="@color/emi_text_secondary"
                        android:background="@null"
                        android:textSize="16sp"
                        android:minHeight="40dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">
                    <TextView
                        android:id="@+id/emi_principal_min_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emi_range_1k"
                        android:textColor="@color/emi_text_secondary"
                        android:textSize="12sp" />
                    <SeekBar
                        android:id="@+id/emi_slider_principal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:max="100"
                        android:progress="10"
                        android:progressDrawable="@drawable/emi_slider_progress"
                        android:thumb="@drawable/emi_slider_thumb" />
                    <TextView
                        android:id="@+id/emi_principal_max_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emi_range_1l"
                        android:textColor="@color/emi_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Interest Rate -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/emi_interest_rate"
                    android:textColor="@color/emi_text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/emi_input_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginBottom="8dp">
                    <EditText
                        android:id="@+id/emi_rate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:hint="10.5"
                        android:textColor="@color/emi_input_text"
                        android:textColorHint="@color/emi_text_secondary"
                        android:background="@null"
                        android:textSize="16sp"
                        android:minHeight="40dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" %"
                        android:textColor="@color/emi_text_secondary"
                        android:textSize="16sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emi_range_1pct"
                        android:textColor="@color/emi_text_secondary"
                        android:textSize="12sp" />
                    <SeekBar
                        android:id="@+id/emi_slider_rate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:max="240"
                        android:progress="105"
                        android:progressDrawable="@drawable/emi_slider_progress"
                        android:thumb="@drawable/emi_slider_thumb" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emi_range_25pct"
                        android:textColor="@color/emi_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Loan Tenure -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/emi_loan_tenure"
                    android:textColor="@color/emi_text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/emi_input_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginBottom="8dp">
                    <EditText
                        android:id="@+id/emi_tenure"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:hint="24"
                        android:textColor="@color/emi_input_text"
                        android:textColorHint="@color/emi_text_secondary"
                        android:background="@null"
                        android:textSize="16sp"
                        android:minHeight="40dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emi_months"
                        android:textColor="@color/emi_text_secondary"
                        android:textSize="16sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emi_range_6m"
                        android:textColor="@color/emi_text_secondary"
                        android:textSize="12sp" />
                    <SeekBar
                        android:id="@+id/emi_slider_tenure"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:max="354"
                        android:progress="18"
                        android:progressDrawable="@drawable/emi_slider_progress"
                        android:thumb="@drawable/emi_slider_thumb" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emi_range_360m"
                        android:textColor="@color/emi_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/emi_calculate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/emi_calculate"
                    android:background="@drawable/emi_button_gradient"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_temp_convert_refresh"
                    android:drawableTint="@android:color/white"
                    android:drawablePadding="12dp"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <!-- Card 2: Your EMI (visibility updated on calculate) -->
            <LinearLayout
                android:id="@+id/emi_result_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/emi_card_bg"
                android:padding="24dp"
                android:elevation="4dp"
                android:layout_marginBottom="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/emi_your_emi"
                    android:textColor="@color/emi_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/emi_result"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/emi_text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:text="@string/emi_sample_result" />

                <TextView
                    android:id="@+id/emi_total_interest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/emi_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/emi_sample_total_interest" />

                <TextView
                    android:id="@+id/emi_total_payment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/emi_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="20dp"
                    android:text="@string/emi_sample_total_payment" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">
                    <com.nuramin.calculator.emi.EmiPieChartView
                        android:id="@+id/emi_pie_chart"
                        android:layout_width="120dp"
                        android:layout_height="120dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@color/emi_pie_principal"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emi_principal"
                        android:textColor="@color/emi_text_secondary"
                        android:textSize="13sp"
                        android:layout_marginEnd="20dp" />
                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@color/emi_pie_interest"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emi_interest"
                        android:textColor="@color/emi_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3: Loan EMI Schedule (accent outline = active control, not disabled) -->
            <LinearLayout
                android:id="@+id/emi_schedule_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/emi_schedule_cta_bg"
                android:foreground="?attr/selectableItemBackground"
                android:padding="20dp"
                android:elevation="6dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/emi_loan_schedule">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_calendar"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:tint="@color/emi_slider_active"
                    android:layout_marginEnd="12dp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/emi_loan_schedule"
                    android:textColor="@color/emi_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_down"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:rotation="-90"
                    android:tint="@color/emi_slider_active" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
