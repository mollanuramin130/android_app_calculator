<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mode_screen_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingStart="@dimen/mode_content_scroll_padding"
        android:paddingEnd="@dimen/mode_content_scroll_padding"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/int_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="@dimen/mode_content_icon_row"
                            android:layout_height="@dimen/mode_content_icon_row"
                            android:src="@drawable/ic_nav_tax"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:layout_marginEnd="@dimen/mode_content_icon_margin_end_title"
                            android:scaleType="fitCenter" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tax_enter_details"
                            android:textColor="@color/int_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="@string/tax_ui_hint"
                        android:textColor="@color/int_text_secondary"
                        android:textSize="12sp" />

                    <RadioGroup
                        android:id="@+id/tax_mode_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp"
                        android:padding="8dp"
                        android:background="@drawable/int_input_bg">

                        <RadioButton
                            android:id="@+id/tax_mode_exclusive"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tax_mode_exclusive"
                            android:checked="true"
                            android:textStyle="bold"
                            android:textColor="@color/int_text_primary" />

                        <RadioButton
                            android:id="@+id/tax_mode_inclusive"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tax_mode_inclusive"
                            android:textStyle="bold"
                            android:textColor="@color/int_text_primary" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tax_amount_label"
                        android:textColor="@color/int_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/tax_amount_input"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/int_input_bg"
                        android:hint="@string/tax_amount_hint"
                        android:inputType="numberDecimal"
                        android:digits="0123456789.,"
                        android:imeOptions="actionNext"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/int_input_text"
                        android:textColorHint="@color/int_text_secondary"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tax_rate_label"
                        android:textColor="@color/int_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/tax_rate_input"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/int_input_bg"
                        android:hint="@string/tax_rate_hint"
                        android:inputType="numberDecimal"
                        android:digits="0123456789.,"
                        android:imeOptions="actionDone"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/int_input_text"
                        android:textColorHint="@color/int_text_secondary"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/tax_calculate_btn"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/int_button_gradient"
                        android:text="@string/tax_calculate"
                        android:textAllCaps="true"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tax_result_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/int_card_bg"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tax_result_title"
                        android:textColor="@color/int_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:id="@+id/tax_result_tax_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tax_breakdown_tax_part"
                            android:textColor="@color/int_text_secondary"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tax_result_tax_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/int_sample_zero"
                            android:textColor="@color/int_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:alpha="0.25"
                        android:background="@color/int_text_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <TextView
                            android:id="@+id/tax_result_amount_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tax_breakdown_total_amount"
                            android:textColor="@color/int_text_secondary"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tax_result_total_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/int_sample_zero"
                            android:textColor="@color/int_text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tax_result_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tax_note_exclusive"
                        android:textColor="@color/int_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

