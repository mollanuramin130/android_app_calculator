<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Currency.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/currency_textinput_stroke</item>
        <item name="hintTextColor">@color/currency_textinput_hint</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/currency_ui_corner_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/currency_ui_corner_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/currency_ui_corner_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/currency_ui_corner_medium</item>
    </style>

    <!-- Currency picker rows: fixed insets so height matches flag row (56dp) -->
    <style name="Widget.Currency.SelectButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">@dimen/currency_ui_corner_medium</item>
        <item name="strokeColor">@color/currency_outline_muted</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="TextAppearance.Currency.ResultValue" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">@color/currency_input_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Currency.RateCaption" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/currency_label_text</item>
    </style>
</resources>
