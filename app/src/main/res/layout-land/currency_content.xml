<?xml version="1.0" encoding="utf-8"?>
<!--
  Currency converter — compact vertical stack. Live conversion; IDs for CurrencyPanel preserved.
  Hint uses ic_currency_live_hint (small vector), not nodpi PNGs, so the info row stays one line tall.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/currency_ui_section_gap">

        <!-- Header: icon + title + hint (matches Tax Calculator pattern) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/currency_ui_inner_gap"
            app:cardBackgroundColor="@color/currency_card_bg"
            app:cardCornerRadius="@dimen/currency_ui_corner_large"
            app:cardElevation="@dimen/currency_ui_card_elevation"
            app:cardUseCompatPadding="false"
            app:strokeColor="@color/currency_outline_muted"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/currency_ui_card_padding_uniform"
                android:paddingTop="@dimen/currency_ui_card_padding_uniform"
                android:paddingEnd="@dimen/currency_ui_card_padding_uniform"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/mode_content_icon_hero"
                        android:layout_height="@dimen/mode_content_icon_hero"
                        android:layout_marginEnd="@dimen/mode_content_icon_margin_end_title"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_generic_currency" />

                    <TextView
                        android:id="@+id/currency_header_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/currency_enter_details"
                        android:textColor="@color/currency_input_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/currency_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/currency_subtitle"
                    android:textColor="@color/currency_label_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Amount: tight insets; avoid double padding (card + large margins). -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/currency_ui_inner_gap"
            app:cardBackgroundColor="@color/currency_card_bg"
            app:cardCornerRadius="@dimen/currency_ui_corner_large"
            app:cardElevation="@dimen/currency_ui_card_elevation"
            app:cardUseCompatPadding="false"
            app:strokeColor="@color/currency_outline_muted"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/currency_amount"
                android:layout_width="match_parent"
                android:layout_height="@dimen/currency_ui_row_min_height"
                android:layout_marginStart="@dimen/currency_ui_amount_margin_h"
                android:layout_marginTop="@dimen/currency_ui_amount_margin_v"
                android:layout_marginEnd="@dimen/currency_ui_amount_margin_h"
                android:layout_marginBottom="@dimen/currency_ui_amount_margin_v"
                android:background="@drawable/bg_currency_input"
                android:gravity="center_vertical"
                android:hint="@string/currency_enter_amount"
                android:importantForAutofill="no"
                android:inputType="numberDecimal|numberSigned"
                android:paddingStart="@dimen/currency_ui_inner_gap"
                android:paddingEnd="@dimen/currency_ui_inner_gap"
                android:textColor="@color/currency_input_text"
                android:textColorHint="@color/currency_label_text"
                android:textSize="18sp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/currency_amount_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/currency_ui_inner_gap"
            android:textColor="@color/currency_primary_tint"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="@string/currency_error_invalid_amount"
            tools:visibility="visible" />

        <!-- FROM -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/currency_ui_block_gap"
            app:cardBackgroundColor="@color/currency_card_bg"
            app:cardCornerRadius="@dimen/currency_ui_corner_large"
            app:cardElevation="@dimen/currency_ui_card_elevation"
            app:cardUseCompatPadding="false"
            app:strokeColor="@color/currency_outline_muted"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/currency_ui_row_min_height"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/currency_ui_inner_gap">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/currency_flag_frame_width_main"
                    android:layout_height="@dimen/currency_flag_frame_height_main"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/currency_ui_inner_gap"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="@dimen/currency_flag_corner_radius"
                    app:cardElevation="@dimen/currency_flag_elevation"
                    app:cardPreventCornerOverlap="false"
                    app:cardUseCompatPadding="false"
                    app:strokeColor="@color/currency_outline_muted"
                    app:strokeWidth="0.5dp">

                    <ImageView
                        android:id="@+id/currency_from_flag"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/currency_flag_frame_inset"
                        android:scaleType="fitCenter"
                        tools:src="@drawable/ic_flag_us" />
                </com.google.android.material.card.MaterialCardView>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/cd_currency_indicator"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_generic_currency"
                    app:tint="@color/currency_primary_tint" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/currency_from"
                    style="@style/Widget.Currency.SelectButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:maxLines="3"
                    android:minHeight="@dimen/currency_ui_row_min_height"
                    android:textAlignment="viewStart"
                    android:textColor="@color/currency_input_text"
                    tools:text="EUR — Euro" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Swap -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/currency_ui_block_gap"
            android:layout_marginBottom="@dimen/currency_ui_block_gap">

            <ImageButton
                android:id="@+id/currency_swap"
                android:layout_width="@dimen/currency_ui_swap_size"
                android:layout_height="@dimen/currency_ui_swap_size"
                android:layout_gravity="center"
                android:background="@drawable/bg_currency_swap_fab"
                android:contentDescription="@string/currency_swap_hint"
                android:elevation="@dimen/currency_ui_card_elevation_raised"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_swap_currencies"
                app:tint="@color/white" />
        </FrameLayout>

        <!-- TO -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/currency_ui_inner_gap"
            app:cardBackgroundColor="@color/currency_card_bg"
            app:cardCornerRadius="@dimen/currency_ui_corner_large"
            app:cardElevation="@dimen/currency_ui_card_elevation"
            app:cardUseCompatPadding="false"
            app:strokeColor="@color/currency_outline_muted"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/currency_ui_row_min_height"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/currency_ui_inner_gap">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/currency_flag_frame_width_main"
                    android:layout_height="@dimen/currency_flag_frame_height_main"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/currency_ui_inner_gap"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="@dimen/currency_flag_corner_radius"
                    app:cardElevation="@dimen/currency_flag_elevation"
                    app:cardPreventCornerOverlap="false"
                    app:cardUseCompatPadding="false"
                    app:strokeColor="@color/currency_outline_muted"
                    app:strokeWidth="0.5dp">

                    <ImageView
                        android:id="@+id/currency_to_flag"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/currency_flag_frame_inset"
                        android:scaleType="fitCenter"
                        tools:src="@drawable/ic_flag_in" />
                </com.google.android.material.card.MaterialCardView>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/cd_currency_indicator"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_generic_currency"
                    app:tint="@color/currency_primary_tint" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/currency_to"
                    style="@style/Widget.Currency.SelectButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:maxLines="3"
                    android:minHeight="@dimen/currency_ui_row_min_height"
                    android:textAlignment="viewStart"
                    android:textColor="@color/currency_input_text"
                    tools:text="INR — Indian Rupee" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/currency_ui_inner_gap"
            android:background="@drawable/bg_currency_live_hint"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/currency_ui_inner_gap"
            android:paddingTop="6dp"
            android:paddingEnd="@dimen/currency_ui_inner_gap"
            android:paddingBottom="6dp"
            android:text="@string/currency_live_conversion_hint"
            android:textColor="@color/currency_label_text"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ic_currency_live_hint"
            app:drawableTint="@color/currency_primary_tint" />

        <!-- Result -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/currency_ui_inner_gap"
            app:cardBackgroundColor="@color/currency_card_bg"
            app:cardCornerRadius="@dimen/currency_ui_corner_large"
            app:cardElevation="@dimen/currency_ui_card_elevation_raised"
            app:cardUseCompatPadding="false"
            app:strokeColor="@color/currency_outline_muted"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/currency_ui_card_padding_uniform">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/currency_converted_label"
                    android:textAllCaps="true"
                    android:textColor="@color/currency_label_text"
                    android:textSize="@dimen/currency_ui_section_label"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/currency_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/currency_ui_block_gap"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="4"
                    android:text="—"
                    android:textColor="@color/currency_input_text"
                    android:textSize="@dimen/currency_ui_result_value"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/currency_ui_inner_gap"
                    android:includeFontPadding="false"
                    android:text="@string/currency_indicative_rate"
                    android:textColor="@color/currency_label_text"
                    android:textSize="@dimen/currency_ui_section_label" />

                <TextView
                    android:id="@+id/currency_indicative_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/currency_ui_block_gap"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="5"
                    android:text="—"
                    android:textColor="@color/currency_input_text"
                    android:textSize="@dimen/currency_ui_result_rate"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/currency_warning_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:text="@string/currency_rates_not_accurate"
            android:textColor="@color/currency_label_text"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
