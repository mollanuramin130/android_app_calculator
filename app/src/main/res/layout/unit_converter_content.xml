<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mode_screen_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="@dimen/mode_content_scroll_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/int_card_bg"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:layout_width="@dimen/mode_content_icon_row"
                        android:layout_height="@dimen/mode_content_icon_row"
                        android:src="@drawable/ic_nav_unit"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="@dimen/mode_content_icon_margin_end_title"
                        android:scaleType="fitCenter" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/unit_converter_title"
                        android:textColor="@color/int_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_category_label"
                    android:textColor="@color/int_text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/unit_category_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/int_input_bg"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_value_label"
                    android:textColor="@color/int_text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/unit_input_value"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/int_input_bg"
                    android:inputType="numberDecimal|numberSigned"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/int_input_text"
                    android:textColorHint="@color/int_text_secondary"
                    android:hint="@string/unit_value_hint"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_from_label"
                    android:textColor="@color/int_text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/unit_from_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/int_input_bg"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_to_label"
                    android:textColor="@color/int_text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/unit_to_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/int_input_bg"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/unit_convert_btn"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="@string/unit_convert_btn"
                        android:textColor="@android:color/white"
                        android:background="@drawable/int_button_gradient"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/unit_swap_btn"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/unit_swap_btn"
                        android:textColor="@android:color/white"
                        android:background="@drawable/int_button_gradient"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/int_card_bg"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_result_label"
                    android:textColor="@color/int_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/unit_result_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0"
                    android:textColor="@color/int_text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/unit_result_formula"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text=""
                    android:textColor="@color/int_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
