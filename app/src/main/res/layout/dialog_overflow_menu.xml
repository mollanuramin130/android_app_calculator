            android:layout_marginStart="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/menu_check_for_updates"
            android:textColor="@color/mode_button_text_light"
            android:textSize="16sp" />
    </LinearLayout>

