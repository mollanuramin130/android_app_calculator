<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.CalculatorButton.Number" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:textColor">@color/text_on_light</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/button_number_bg</item>
        <item name="backgroundTint">@null</item>
        <item name="android:elevation">@dimen/button_elevation</item>
    </style>

    <style name="Widget.CalculatorButton.Operator" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:textColor">@color/text_on_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/button_operator_bg</item>
        <item name="backgroundTint">@null</item>
        <item name="android:elevation">@dimen/button_elevation</item>
    </style>

    <style name="Widget.CalculatorButton.Zero" parent="Widget.CalculatorButton.Number">
        <item name="android:background">@drawable/button_zero_bg</item>
    </style>

    <!-- Mode UI: dark key (white text) -->
    <style name="Widget.CalculatorButton.ModeDark" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:textSize">@dimen/mode_key_text_size</item>
        <item name="android:textColor">@color/mode_button_text_light</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/button_mode_dark</item>
        <item name="backgroundTint">@null</item>
    </style>
    <!-- Mode UI: light key (AC, =) dark text -->
    <style name="Widget.CalculatorButton.ModeLight" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:textSize">@dimen/mode_key_text_size</item>
        <item name="android:textColor">@color/mode_button_text_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/button_mode_light</item>
        <item name="backgroundTint">@null</item>
    </style>
    <!-- Keypad "white" style: light grey keys (dark text) / AC and = dark (white text) -->
    <!-- Keys do not take focus: keeps the expression field focused like standard calculator apps,
         so selection/cursor state stays valid while tapping digits and backspace. -->
    <style name="Widget.CalculatorButton.KeypadStandard" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:textSize">@dimen/mode_key_text_size</item>
        <item name="android:textColor">@color/keypad_standard_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/button_keypad_standard</item>
        <item name="backgroundTint">@null</item>
        <item name="android:focusable">false</item>
        <item name="android:focusableInTouchMode">false</item>
    </style>
    <style name="Widget.CalculatorButton.KeypadAccent" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:textSize">@dimen/mode_key_text_size</item>
        <item name="android:textColor">@color/keypad_accent_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/button_keypad_accent</item>
        <item name="backgroundTint">@null</item>
        <item name="android:focusable">false</item>
        <item name="android:focusableInTouchMode">false</item>
    </style>
    <!-- Scientific function keys: smaller text, auto-size to fit, real calculator key look -->
    <style name="Widget.CalculatorButton.KeypadScientific" parent="Widget.CalculatorButton.KeypadStandard">
        <item name="android:textSize">@dimen/mode_scientific_key_text_size</item>
        <item name="android:padding">6dp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">7sp</item>
        <item name="android:autoSizeMaxTextSize">14sp</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Dark overflow menu (3-dot) to match calculator UI -->
    <style name="PopupMenuStyle" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_menu_bg</item>
    </style>
</resources>
