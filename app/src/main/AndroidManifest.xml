<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Mic is optional (AI voice); do not require hardware mic for install eligibility. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Play device catalog: explicit optional hardware so TV / no-mic devices stay eligible. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/launcher_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SunsetCoralCalculator">
        <activity
            android:name="com.nuramin.calculator.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/launcher_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:theme="@style/Theme.SunsetCoralCalculator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.nuramin.calculator.date.DateCalculatorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SunsetCoralCalculator" />
        <activity
            android:name="com.nuramin.sunsetcoralcalculator.ai.ui.AISmartActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SunsetCoralCalculator" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
