<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mode_screen_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/mode_screen_bg"
        android:padding="16dp"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Enter Details card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/int_card_bg"
                android:padding="16dp"
                android:elevation="6dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_drawer_interest"
                        android:contentDescription="@null"
                        android:tint="@color/int_text_primary"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/int_enter_details"
                        android:textColor="@color/int_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Segmented toggle: Simple / Compound -->
                <RadioGroup
                    android:id="@+id/interest_type"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:background="@drawable/int_segmented_container"
                    android:padding="4dp"
                    android:layout_marginBottom="20dp">
                    <RadioButton
                        android:id="@+id/interest_simple"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/int_simple"
                        android:textColor="@color/int_segmented_tab_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:button="@null"
                        android:background="@drawable/int_segmented_tab_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:checked="true" />
                    <RadioButton
                        android:id="@+id/interest_compound"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/int_compound"
                        android:textColor="@color/int_segmented_tab_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:button="@null"
                        android:background="@drawable/int_segmented_tab_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                </RadioGroup>

                <!-- Principal Amount -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/int_principal_amount"
                    android:textColor="@color/int_text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/int_input_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text="@string/int_rupee"
                        android:textColor="@color/int_text_primary"
                        android:textSize="15sp"
                        android:gravity="center" />
                    <EditText
                        android:id="@+id/interest_principal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:hint="50,000"
                        android:textColor="@color/int_input_text"
                        android:textColorHint="@color/int_text_secondary"
                        android:background="@null"
                        android:textSize="15sp"
                        android:gravity="center_vertical|end"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_down"
                        android:contentDescription="@null"
                        android:tint="@color/int_text_secondary" />
                </LinearLayout>

                <!-- Interest Rate (P.A.) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/int_interest_rate_pa"
                    android:textColor="@color/int_text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/int_input_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text="%"
                        android:textColor="@color/int_text_primary"
                        android:textSize="15sp"
                        android:gravity="center" />
                    <EditText
                        android:id="@+id/interest_rate"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:hint="8.5"
                        android:textColor="@color/int_input_text"
                        android:textColorHint="@color/int_text_secondary"
                        android:background="@null"
                        android:textSize="15sp"
                        android:gravity="center_vertical|end"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_down"
                        android:contentDescription="@null"
                        android:tint="@color/int_text_secondary" />
                </LinearLayout>

                <!-- Time Period -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/int_time_period"
                    android:textColor="@color/int_text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/int_input_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="24dp">
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:visibility="invisible" />
                    <EditText
                        android:id="@+id/interest_time"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:hint="5"
                        android:textColor="@color/int_input_text"
                        android:textColorHint="@color/int_text_secondary"
                        android:background="@null"
                        android:textSize="15sp"
                        android:gravity="center_vertical|end"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                    <Spinner
                        android:id="@+id/interest_time_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="80dp"
                        android:background="@android:color/transparent"
                        android:spinnerMode="dropdown"
                        android:paddingStart="4dp"
                        android:paddingEnd="24dp" />
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_down"
                        android:contentDescription="@null"
                        android:tint="@color/int_text_secondary" />
                </LinearLayout>

                <Button
                    android:id="@+id/interest_calculate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/int_calculate"
                    android:background="@drawable/int_button_gradient"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_temp_convert_refresh"
                    android:drawableTint="@android:color/white"
                    android:drawablePadding="8dp"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <!-- Result card -->
            <LinearLayout
                android:id="@+id/interest_result_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/int_card_bg"
                android:padding="16dp"
                android:elevation="6dp"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_drawer_interest"
                        android:contentDescription="@null"
                        android:tint="@color/int_text_primary"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/int_result"
                        android:textColor="@color/int_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/int_total_interest"
                    android:textColor="@color/int_text_primary"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />
                <TextView
                    android:id="@+id/interest_result"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/int_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:text="₹ 0" />

                <TextView
                    android:id="@+id/interest_total_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/int_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:text="Total Amount (Principal + ₹0)" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/int_divider"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/int_breakdown"
                        android:textColor="@color/int_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:gravity="center"
                        android:background="@drawable/int_info_circle_bg"
                        android:text="?"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/int_principal_amount_label"
                        android:textColor="@color/int_text_secondary"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/interest_breakdown_principal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/int_text_primary"
                        android:textSize="14sp"
                        android:text="₹ 0" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/interest_breakdown_interest_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/int_compound_interest_label"
                        android:textColor="@color/int_text_secondary"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/interest_breakdown_interest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/int_text_primary"
                        android:textSize="14sp"
                        android:text="₹ 0" />
                </LinearLayout>

                <Button
                    android:id="@+id/interest_view_breakdown"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/int_view_breakdown"
                    android:background="@drawable/int_view_breakdown_btn"
                    android:textColor="@color/int_view_breakdown_btn_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_drawer_interest"
                    android:drawableEnd="@drawable/ic_chevron_down"
                    android:drawableTint="@color/int_view_breakdown_btn_text"
                    android:drawablePadding="8dp"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
