<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp"
    android:background="@drawable/bg_history_item_card"
    android:minHeight="64dp"
    android:layout_marginHorizontal="4dp"
    android:layout_marginBottom="8dp">

    <HorizontalScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:scrollbars="horizontal"
        android:fillViewport="false"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:minWidth="120dp">

            <TextView
                android:id="@+id/history_expression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/history_label_text"
                android:textSize="14sp"
                android:singleLine="true"
                android:ellipsize="none"
                android:gravity="end" />

            <TextView
                android:id="@+id/history_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/mode_button_text_light"
                android:textSize="18sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="none"
                android:gravity="end" />

            <TextView
                android:id="@+id/history_timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/history_timestamp_text"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:gravity="end" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minWidth="0dp">

        <Button
            android:id="@+id/history_btn_use"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="64dp"
            android:text="@string/history_use"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/button_history_use"
            android:textColor="@color/white"
            android:elevation="2dp"
            style="?android:attr/borderlessButtonStyle" />

        <ImageButton
            android:id="@+id/history_btn_dismiss"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_history_dismiss_icon"
            android:src="@drawable/ic_close"
            app:tint="@color/history_label_icon"
            android:contentDescription="@string/history_dismiss"
            android:scaleType="centerInside"
            android:padding="6dp"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>
</LinearLayout>
