<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/puzzle_game_gradient"
    android:scrollbars="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/mode_content_scroll_padding"
        android:paddingEnd="@dimen/mode_content_scroll_padding"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/puzzle_hero_icon"
        android:layout_width="@dimen/mode_content_icon_hero"
        android:layout_height="@dimen/mode_content_icon_hero"
        android:layout_marginTop="8dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_nav_number_puzzle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/puzzle_title_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/puzzle_game_title"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/puzzle_hero_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/puzzle_subtitle_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/puzzle_subtitle"
        android:textColor="#CFD8DC"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/puzzle_title_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/puzzle_score_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/puzzle_score"
        android:textColor="#FFD54F"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Score: 0"
        app:layout_constraintTop_toBottomOf="@id/puzzle_subtitle_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/puzzle_target_card"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="18dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#37474F"
        app:layout_constraintTop_toBottomOf="@id/puzzle_score_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/puzzle_target_value"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="36sp"
            android:textStyle="bold"
            tools:text="Target: 24" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/puzzle_expression_card"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#455A64"
        app:layout_constraintTop_toBottomOf="@id/puzzle_target_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/puzzle_expression_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:padding="12dp"
            tools:text="8 × 3" />
    </com.google.android.material.card.MaterialCardView>

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/puzzle_numbers_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:columnCount="2"
        app:rowCount="2"
        app:useDefaultMargins="false"
        app:layout_constraintTop_toBottomOf="@id/puzzle_expression_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/puzzle_num_0"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:textSize="22sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:backgroundTint="#1E88E5"
            app:layout_column="0"
            app:layout_columnWeight="1"
            app:layout_row="0"
            app:layout_rowWeight="0" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/puzzle_num_1"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:textSize="22sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:backgroundTint="#1E88E5"
            app:layout_column="1"
            app:layout_columnWeight="1"
            app:layout_row="0"
            app:layout_rowWeight="0" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/puzzle_num_2"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:textSize="22sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:backgroundTint="#1E88E5"
            app:layout_column="0"
            app:layout_columnWeight="1"
            app:layout_row="1"
            app:layout_rowWeight="0" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/puzzle_num_3"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:textSize="22sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:backgroundTint="#1E88E5"
            app:layout_column="1"
            app:layout_columnWeight="1"
            app:layout_row="1"
            app:layout_rowWeight="0" />
    </androidx.gridlayout.widget.GridLayout>

    <LinearLayout
        android:id="@+id/puzzle_operators_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/puzzle_numbers_grid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/puzzle_op_plus"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="70dp"
            android:layout_height="50dp"
            android:layout_marginEnd="5dp"
            android:text="+"
            android:textSize="20sp"
            app:cornerRadius="12dp"
            app:backgroundTint="#26A69A" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/puzzle_op_minus"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="70dp"
            android:layout_height="50dp"
            android:layout_marginEnd="5dp"
            android:text="−"
            android:textSize="20sp"
            app:cornerRadius="12dp"
            app:backgroundTint="#26A69A" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/puzzle_op_multiply"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="70dp"
            android:layout_height="50dp"
            android:layout_marginEnd="5dp"
            android:text="×"
            android:textSize="20sp"
            app:cornerRadius="12dp"
            app:backgroundTint="#26A69A" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/puzzle_op_divide"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="70dp"
            android:layout_height="50dp"
            android:text="÷"
            android:textSize="20sp"
            app:cornerRadius="12dp"
            app:backgroundTint="#26A69A" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/puzzle_control_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/puzzle_operators_row"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/puzzle_btn_clear"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/puzzle_clear"
            android:textAllCaps="true"
            app:cornerRadius="12dp"
            app:backgroundTint="#FF9800" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/puzzle_btn_submit"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/puzzle_submit"
            android:textAllCaps="true"
            app:cornerRadius="12dp"
            app:backgroundTint="#E53935" />
    </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
