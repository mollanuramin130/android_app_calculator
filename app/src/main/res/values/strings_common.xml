    <string name="privacy_policy_title">Privacy Policy</string>
    <string name="privacy_policy_content">Nur\'s Custom Calculator respects your privacy.\n\n• This app does not collect personal data. Calculations are performed on your device only.\n\n• History is stored locally on your device and is not sent to any server.\n\n• If you contact us via Send feedback, we receive only the email content you choose to send (e.g. to mollanuramin130@gmail.com) to respond to your request.\n\n• We do not use analytics or third-party tracking in this app.\n\n• For questions about this policy, email mollanuramin130@gmail.com.</string>
    <string name="feedback_email_subject">Nur\'s Custom Calculator – Feedback</string>
