<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/mode_content_scroll_padding"
    android:paddingEnd="@dimen/mode_content_scroll_padding"
    android:paddingTop="12dp"
    android:paddingBottom="16dp"
    android:background="@drawable/memory_grid_game_gradient">

    <ImageView
        android:id="@+id/memory_grid_hero_icon"
        android:layout_width="@dimen/mode_content_icon_hero"
        android:layout_height="@dimen/mode_content_icon_hero"
        android:layout_marginTop="8dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_nav_memory_grid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/memory_grid_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/memory_grid_title"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/memory_grid_hero_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/memory_grid_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/memory_grid_subtitle"
        android:textColor="#CFD8DC"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/memory_grid_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/memory_grid_level_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/memory_grid_level"
        android:textColor="#FFD54F"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="Level 1"
        app:layout_constraintTop_toBottomOf="@id/memory_grid_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/memory_grid_score_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/memory_grid_score"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        tools:text="Score: 0"
        app:layout_constraintTop_toBottomOf="@id/memory_grid_level_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/memory_grid_memorize_time_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="#B0BEC5"
        android:textSize="13sp"
        tools:text="Memorize: 2.8 s · +0.2 s per level"
        app:layout_constraintTop_toBottomOf="@id/memory_grid_score_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/memory_grid_chances_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="#FFE082"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Chances: 3"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/memory_grid_memorize_time_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/memory_grid_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:columnCount="4"
        app:rowCount="4"
        app:useDefaultMargins="false"
        app:alignmentMode="alignBounds"
        app:layout_constraintTop_toBottomOf="@id/memory_grid_chances_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/memory_grid_start_btn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:text="@string/memory_grid_start_btn_text"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textAllCaps="true"
        app:cornerRadius="14dp"
        app:backgroundTint="#1E88E5"
        app:layout_constraintTop_toBottomOf="@id/memory_grid_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
