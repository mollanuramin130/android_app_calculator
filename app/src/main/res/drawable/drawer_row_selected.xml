<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer row highlight when Date Calculator screen is active. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/quick_bar_divider" />
        </shape>
    </item>
    <item
        android:left="0dp"
        android:top="8dp"
        android:bottom="8dp"
        android:width="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/coral_deep" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
