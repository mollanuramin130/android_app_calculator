<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="5dp"
    android:background="@drawable/bg_history_item_card"
    android:minHeight="48dp"
    android:layout_marginHorizontal="4dp"
    android:layout_marginBottom="4dp">

    <HorizontalScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:scrollbars="horizontal"
        android:fillViewport="false"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:minWidth="80dp">

            <TextView
                android:id="@+id/history_expression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/history_label_text"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="none"
                android:gravity="end"
                android:lineSpacingMultiplier="1.1" />

            <TextView
                android:id="@+id/history_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:textColor="@color/mode_button_text_light"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="none"
                android:gravity="end" />

            <TextView
                android:id="@+id/history_timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:textColor="@color/history_timestamp_text"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:gravity="end" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minWidth="0dp">

        <ImageButton
            android:id="@+id/history_btn_use"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_history_icon_btn"
            android:src="@drawable/ic_history_use_result"
            app:tint="@color/white"
            android:contentDescription="@string/history_use_result"
            android:scaleType="centerInside"
            android:padding="6dp"
            style="?android:attr/borderlessButtonStyle" />

        <ImageButton
            android:id="@+id/history_btn_use_expr"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_history_icon_btn"
            android:src="@drawable/ic_history_use_expr"
            app:tint="@color/white"
            android:contentDescription="@string/history_use_expression"
            android:scaleType="centerInside"
            android:padding="6dp"
            style="?android:attr/borderlessButtonStyle" />

        <ImageButton
            android:id="@+id/history_btn_dismiss"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_history_dismiss_icon"
            android:src="@drawable/ic_close"
            app:tint="@color/history_label_icon"
            android:contentDescription="@string/history_dismiss"
            android:scaleType="centerInside"
            android:padding="5dp"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>
</LinearLayout>
