<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SunsetCoralCalculator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/mode_screen_bg</item>
        <item name="android:navigationBarColor">@color/mode_screen_bg</item>
        <item name="android:windowBackground">@color/mode_screen_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Use coral as primary so no purple appears -->
        <item name="colorPrimary">@color/coral_dark</item>
        <item name="colorPrimaryVariant">@color/coral_deep</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Prevent Material from tinting our custom button backgrounds -->
        <item name="colorButtonNormal">@color/button_number_bg</item>
        <!-- Dark 3-dot overflow menu -->
        <item name="popupMenuStyle">@style/PopupMenuStyle</item>
    </style>

    <!-- Theme overlay so overflow menu has dark background and white text -->
    <style name="ThemeOverlay.PopupMenuDark" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="popupMenuStyle">@style/PopupMenuStyle</item>
        <item name="android:textColorPrimary">@color/mode_button_text_light</item>
        <item name="android:colorBackground">@color/mode_menu_bg</item>
        <item name="colorOnSurface">@color/mode_button_text_light</item>
        <item name="android:windowBackground">@color/mode_menu_bg</item>
    </style>
</resources>
